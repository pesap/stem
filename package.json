      "bins": {
        "stem": "stem"
      },
      "zipExt": ".tar.xz"
    },
    "x86_64-apple-darwin": {
      "artifactName": "stem-x86_64-apple-darwin.tar.xz",
      "bins": {
        "stem": "stem"
      },
      "zipExt": ".tar.xz"
    },
    "x86_64-pc-windows-gnu": {
      "artifactName": "stem-x86_64-pc-windows-msvc.zip",
      "bins": {
        "stem": "stem.exe"
      },
      "zipExt": ".zip"
    },
    "x86_64-pc-windows-msvc": {
      "artifactName": "stem-x86_64-pc-windows-msvc.zip",
      "bins": {
        "stem": "stem.exe"
      },
      "zipExt": ".zip"
    },
    "x86_64-unknown-linux-gnu": {
      "artifactName": "stem-x86_64-unknown-linux-gnu.tar.xz",
      "bins": {
        "stem": "stem"
      },
      "zipExt": ".tar.xz"
