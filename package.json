    "npm": ">=6"
  },
  "glibcMinimum": {
    "major": 2,
    "series": 31
  },
  "homepage": "https://github.com/pesap/stem",
  "name": "stem",
  "preferUnplugged": true,
  "repository": "https://github.com/pesap/stem",
  "scripts": {
    "postinstall": "node ./install.js"
  },
  "supportedPlatforms": {
    "aarch64-apple-darwin": {
