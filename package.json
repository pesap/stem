{
  "name": "@gpac/stem",
  "version": "0.1.0",
  "description": "Generate Sienna PowerSimulations Julia scripts from configuration files",
  "type": "module",
  "bin": {
    "stem": "dist/cli.js"
  },
  "files": [
    "dist/",
    "examples/",
    "templates/"
  ],
  "homepage": "https://github.com/pesap/stem",
  "repository": "https://github.com/pesap/stem",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "tsx --test test/*.test.ts",
    "format": "prettier --write \"package.json\" \"tsconfig.json\" \"src/**/*.ts\" \"test/**/*.ts\" \".github/workflows/*.yml\"",
    "format:check": "prettier --check \"package.json\" \"tsconfig.json\" \"src/**/*.ts\" \"test/**/*.ts\" \".github/workflows/*.yml\"",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@clack/core": "1.5.1",
    "@clack/prompts": "^1.8.1",
    "nunjucks": "^3.2.4",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/nunjucks": "^3.2.6",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "registry": "https://npm.github.nrel.gov/"
  }
}
